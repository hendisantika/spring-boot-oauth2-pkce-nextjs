# Public URL of this Next.js app
APP_URL=http://localhost:3000

# Spring Boot Authorization Server (issuer) and Resource Server
AUTH_ISSUER=http://localhost:8080
AUTH_CLIENT_ID=pkce-client
AUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
AUTH_SCOPES="openid profile email notes.read notes.write"
API_BASE_URL=http://localhost:8080

# 32+ character secret used to encrypt the session cookie (openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-secret-value
